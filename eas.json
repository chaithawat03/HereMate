{
  "build": {
    "android-preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "staging"
      }
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "staging"
      }
    },
    "android-guest-staging": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_ENABLE_FIREBASE_GUEST": "true",
        "EXPO_PUBLIC_ENABLE_LOCAL_GPS": "true",
        "EXPO_PUBLIC_ENABLE_M1_PROFILE": "true",
        "EXPO_PUBLIC_ENABLE_GOOGLE_SIGNIN": "true",
        "EXPO_PUBLIC_ENABLE_M1_FRIENDS": "true"
      }
    },
    "ios-guest-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_ENABLE_FIREBASE_GUEST": "true",
        "EXPO_PUBLIC_ENABLE_LOCAL_GPS": "true",
        "EXPO_PUBLIC_ENABLE_M1_PROFILE": "true"
      }
    }
  }
}
