rules_version = '2';

// HereMate M0.5.3 staging bootstrap — DENY ALL client reads/writes.
//
// Backend-only collections private_phone_auth and private_auth_rate_limits
// contain credential verifiers and login abuse counters. No client (including
// Firebase-authenticated Google/Anonymous users) may access these documents.
//
// This ruleset is intentionally NOT deployed by this PR; a later reviewed
// rules deployment will add narrowly scoped per-user profile/friend permissions,
// after emulator ACL tests. Firebase Admin SDK bypasses security rules and
// MUST use a narrowly scoped runtime service account with IAM controls.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
