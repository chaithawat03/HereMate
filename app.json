{
  "expo": {
    "name": "HereMate",
    "slug": "heremate",
    "owner": "smartyyys-team",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "heremate",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chaithawat03.heremate"
    },
    "android": {
      "package": "com.chaithawat03.heremate",
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "environment": "staging",
      "eas": {
        "projectId": "93bb1566-2f29-4898-bba3-30f93b8deb6e"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HereMate to read your location only while you run the local GPS trial.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
